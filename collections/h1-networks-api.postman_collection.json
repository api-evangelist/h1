          "name": "Network Analysis Based on Geography",
          "request": {
            "name": "Network Analysis Based on Geography",
            "description": {
              "content": "View a provider network across different geographies (i.e. counties).\n\n#### Example Use Case\nIn looking to expand to a new region, analyze existing provider networks in the region to understand how best to construct your own.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "network_analysis"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "insurance_id",
                  "value": "<uuid>",
                  "description": "(Required) A unique identifier for a single provider network from the Insurances reference endpoint."
                },
                {
                  "disabled": false,
                  "key": "ssa_codes",
                  "value": "<string>",
                  "description": "(Required) SSA codes of the counties to run a network analysis on. \n\nA maximum of 50 codes may be included in a single request.\n"
                },
                {
                  "disabled": false,
                  "key": "exclude_npis",
                  "value": "false",
                  "description": "When set to `true` the response will not list specific NPIs in the network but will continue to include the `npi_count` fields to let you know how many there are.\n\nThis parameter can be used to greater lower the amount of data sent back when specific NPIs are not necessary.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
